# Copy this file to `.env` and fill in real values for local Docker Compose runs.
# `.env` is gitignored and must never be committed.

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=changeme
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=library-db

# --- Backend ---
# Connection string must match the MongoDB credentials above.
SPRING_MONGODB_URI=mongodb://changeme:changeme@mongodb:27017/library-db?authSource=admin
# Base64 256-bit key. Generate one with: openssl rand -base64 32
JWT_SECRET_KEY=generate-with-openssl-rand-base64-32
CORS_ALLOWED_ORIGINS=http://localhost
